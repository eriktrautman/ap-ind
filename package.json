{
  "name": "ap-ind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AP Elections API middleware for an election-night broadcast focused on independent candidates",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node --env-file=.env src/probe.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "typescript": "^5.8.3"
  }
}
