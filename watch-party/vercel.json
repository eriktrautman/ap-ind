{
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/race/:label",
      "destination": "/race"
    },
    {
      "source": "/data/:path*",
      "destination": "https://lhxyw7zt9v9qfbh3.public.blob.vercel-storage.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/geo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, immutable"
        }
      ]
    },
    {
      "source": "/data/status.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=10, s-maxage=20, stale-while-revalidate=40"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ."
}
