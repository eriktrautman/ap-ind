# Copy to .env (gitignored). Only AP_API_KEY and STUDIO_PASSWORD are required to run locally.
AP_API_KEY=
AP_RESULTS_TYPE=t            # t = AP test data, l = live
STUDIO_PASSWORD=change-me    # shared control room password

# Where the JSON files go. Pick one:
STORE_DIR=./data             # local files on this machine (no Vercel needed)
# BLOB_READ_WRITE_TOKEN=     # or: share the deployment's Vercel Blob store (what production uses); unset STORE_DIR

# Production: what the control room pushes to and pulls from
GLOBAL=https://ap-ind.vercel.app   # the deployment; or GLOBAL=self to make this machine production (standby)
# GLOBAL_PASSWORD=                 # the deployment's studio password; without it you can pull but not push

# Optional
# POLL_SECONDS=60            # poller interval for npm start
# PORT=3000
# CRON_SECRET=               # Vercel only: lets the cron call /api/poll
