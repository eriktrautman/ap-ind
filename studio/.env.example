# Copy to .env (gitignored). Only AP_API_KEY and one STUDIO_PASSWORD_PRODUCER_* are required to run locally.
AP_API_KEY=
AP_RESULTS_TYPE=t            # t = AP test data, l = live
# AP_ELECTION_DATE=2026-11-03   # the election the poller asks AP for; this is the default
STUDIO_PASSWORD_PRODUCER_FIRST_LAST=change-me   # one per person; the name says what it entitles: PRODUCER (everything), PUBLISHER, READONLY
# STUDIO_PASSWORD_PUBLISHER_FIRST_LAST=            # publishes the ticker and live screens; no Test/Live, pause or poll
# STUDIO_PASSWORD_READONLY_FIRST_LAST=             # looks at everything, changes nothing published
# STUDIO_TEST_PASSWORD=test1234                    # the rehearsal password: look only, off once results are Live

# Where this machine's JSON files live. A laptop always keeps its own; as a standby it mirrors the deployment into them.
STORE_DIR=./data             # local files on this machine (no Vercel needed)
# BLOB_READ_WRITE_TOKEN=     # leave off a laptop; only `npm run poll` (standing in for a dead cron) writes production's store

# Production: what the Studio publishes to and pulls from
GLOBAL=https://electionproducer.com   # the deployment is production and this laptop its standby (mirrors it every MIRROR_SECONDS);
                                   # GLOBAL=self makes this machine production from the start (normally use Promote in the Studio instead)
# GLOBAL_PASSWORD=                 # your own password on the deployment; without it you can pull but not publish

# Optional
# POLL_SECONDS=60            # AP polling interval once this machine is production
# MIRROR_SECONDS=30          # how often a standby copies the deployment's files
# PORT=3000
# CRON_SECRET=               # Vercel only: lets the cron call /api/poll
