# Copy to .env (gitignored). Only AP_API_KEY and one STUDIO_PASSWORD_PRODUCER_* are required to run locally.
AP_API_KEY=
AP_RESULTS_TYPE=t            # t = AP test data, l = live
STUDIO_PASSWORD_PRODUCER_ERIK_TRAUTMAN=change-me   # one per person; the name says what it entitles: PRODUCER (everything), PUBLISHER, READONLY
# STUDIO_PASSWORD_PUBLISHER_FIRST_LAST=            # publishes the ticker and live screens; no Test/Live, pause or poll
# STUDIO_PASSWORD_READONLY_FIRST_LAST=             # looks at everything, changes nothing published
# STUDIO_TEST_PASSWORD=test1234                    # the rehearsal password: look only, off once results are Live

# Where the JSON files go. Pick one:
STORE_DIR=./data             # local files on this machine (no Vercel needed)
# BLOB_READ_WRITE_TOKEN=     # or: share the deployment's Vercel Blob store (what production uses); unset STORE_DIR

# Production: what the control room pushes to and pulls from
GLOBAL=https://ap-ind.vercel.app   # the deployment; or GLOBAL=self to make this machine production (standby)
# GLOBAL_PASSWORD=                 # your own password on the deployment; without it you can pull but not publish

# Optional
# POLL_SECONDS=60            # poller interval for npm start
# PORT=3000
# CRON_SECRET=               # Vercel only: lets the cron call /api/poll
