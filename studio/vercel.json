{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/poll",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/g/:chart",
      "destination": "/g/chart"
    },
    {
      "source": "/data/:path*",
      "destination": "https://lhxyw7zt9v9qfbh3.public.blob.vercel-storage.com/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/studio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/studio/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lookbook",
      "destination": "/graphics-data-options",
      "permanent": true
    },
    {
      "source": "/lookbook.html",
      "destination": "/graphics-data-options",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=10, s-maxage=15, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(ticker|ticker-queue|live-screen)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
