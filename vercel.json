{
  "outputDirectory": "docs",
  "buildCommand": "rm -rf docs/g docs/geo && cp -r public/g docs/g && cp -r watch-party/public/geo docs/geo",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/lookbook",
      "destination": "/graphics-data-options",
      "permanent": true
    },
    {
      "source": "/lookbook.html",
      "destination": "/graphics-data-options",
      "permanent": true
    }
  ]
}
